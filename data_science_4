import streamlit as st
import pandas as pd
import os

@st.cache_data
def load_data():
    file_path = os.path.join(
        os.path.dirname(__file__),
        "hh_kazakhstan_final_dataset.csv.gz"
    )
    return pd.read_csv(file_path)


def city_recommendation_block(user_city=None):
    df = load_data()

    # 👉 предполагаем, что колонка с городом называется "city"
    city_counts = (
        df["city"]
        .value_counts()
        .reset_index()
    )

    city_counts.columns = ["Город", "Количество вакансий"]

    st.markdown("## 🌍 В каком городе тебе будет проще найти работу?")

    st.markdown(
        """
        <p style="color:gray;">
        Мы проанализировали рынок вакансий и показали города
        с наибольшим количеством предложений
        </p>
        """,
        unsafe_allow_html=True
    )

    # --- Красивый вывод ---
    for _, row in city_counts.head(5).iterrows():
        city = row["Город"]
        count = row["Количество вакансий"]

        emoji = "⭐"
        if user_city == city:
            emoji = "📍"

        st.markdown(
            f"""
            <div style="
                background-color:#f4f8fb;
                padding:16px;
                border-radius:14px;
                margin-bottom:10px;
                font-size:18px;
            ">
                {emoji} <b>{city}</b> — {count} вакансий
            </div>
            """,
            unsafe_allow_html=True
        )
